+def build_lr_scheduler(optimizer, accelerator, num_samples, args=None):
+    """expv2 patch (diffsynth-cosine-lr.patch). Steps are OPTIMIZER steps: the scheduler is
+    prepared by accelerate, whose AcceleratedScheduler only advances when gradients sync,
+    i.e. once per gradient_accumulation_steps samples."""
+    kind = getattr(args, "lr_scheduler", "constant") if args is not None else "constant"
+    if kind == "constant":
+        return torch.optim.lr_scheduler.ConstantLR(optimizer)
+    accum = max(1, int(getattr(accelerator, "gradient_accumulation_steps", 1)))
+    total = max(1, math.ceil(num_samples / accum))
+    warmup = max(0, int(getattr(args, "lr_warmup_steps", 0)))
+    floor = float(getattr(args, "lr_min_ratio", 0.1))
+
+    def lr_lambda(step):
+        if step < warmup:
+            return (step + 1) / warmup
+        progress = min(1.0, (step - warmup) / max(1, total - warmup))
+        return floor + (1.0 - floor) * 0.5 * (1.0 + math.cos(math.pi * progress))
+
+    if accelerator.is_main_process:
+        print(f"[expv2] lr schedule: cosine, {total} optimizer steps ({num_samples} samples / accum {accum}), "
+              f"warmup {warmup}, floor {floor:g} x lr", flush=True)
+    return torch.optim.lr_scheduler.LambdaLR(optimizer, lr_lambda)
+
+
